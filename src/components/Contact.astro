---
import Icon from './Icon.astro';
import { contact, profile } from '../data/site.js';
---

<section class="section" id="contact">
  <div class="glow glow--primary contact__glow"></div>

  <div class="container contact">
    <div class="contact__copy" data-reveal>
      <p class="eyebrow">{contact.eyebrow}</p>
      <h2 class="t-h2 contact__title">
        {contact.heading.map((line) => <span class="contact__line">{line}</span>)}
      </h2>
      <p class="t-lead contact__body">{contact.body}</p>

      <div class="contact__actions">
        <a class="btn btn--primary" href={`mailto:${profile.email}`}>
          <Icon name="mail" size={16} />
          Send an Email
        </a>
        {
          profile.resumeUrl && (
            <a class="btn btn--ghost" href={profile.resumeUrl} download>
              <Icon name="download" size={16} />
              Download CV
            </a>
          )
        }
      </div>
    </div>

    <div class="contact__panel" data-reveal data-reveal-delay="100">
      <ul class="contact__methods">
        {
          contact.methods.map((method) =>
            method.href ? (
              <li>
                <a class="contact__row card card--hover" href={method.href}>
                  <span class="icon-tile icon-tile--secondary">
                    <Icon name={method.icon} size={17} />
                  </span>
                  <span class="contact__text">
                    <span class="contact__label">{method.label}</span>
                    <span class="contact__value">{method.value}</span>
                  </span>
                  <Icon name="arrow" size={16} class="contact__arrow" />
                </a>
              </li>
            ) : (
              <li>
                <div class="contact__row card">
                  <span class="icon-tile icon-tile--secondary">
                    <Icon name={method.icon} size={17} />
                  </span>
                  <span class="contact__text">
                    <span class="contact__label">{method.label}</span>
                    <span class="contact__value">{method.value}</span>
                  </span>
                </div>
              </li>
            )
          )
        }
      </ul>

      <div class="contact__availability">
        <p class="contact__availability-title">
          <span class="dot dot--pulse"></span>
          {contact.availability.title}
        </p>
        <p class="contact__availability-body">{contact.availability.body}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    position: relative;
    overflow: hidden;
  }

  .contact__glow {
    width: 460px;
    height: 460px;
    bottom: -220px;
    left: -120px;
  }

  .contact {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--sp-2xl);
    align-items: start;
  }
  @media (min-width: 960px) {
    .contact {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--sp-3xl);
    }
  }

  .contact__title {
    margin-top: var(--sp-md);
    text-wrap: balance;
  }
  .contact__line {
    display: block;
  }

  .contact__body {
    margin-top: var(--sp-lg);
    max-width: 44ch;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-sm);
    margin-top: var(--sp-xl);
  }
  @media (max-width: 420px) {
    .contact__actions .btn {
      flex: 1 1 100%;
    }
  }

  /* ---------------------------------------------------------- panel */
  .contact__methods {
    display: grid;
    gap: var(--sp-sm);
  }

  .contact__row {
    display: flex;
    align-items: center;
    gap: var(--sp-md);
    padding: var(--sp-md);
    border-radius: var(--r-md);
  }

  .contact__text {
    min-width: 0;
    display: block;
  }

  .contact__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .contact__value {
    display: block;
    margin-top: 0.1875rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-1);
    overflow-wrap: anywhere;
  }

  .contact__row :global(.contact__arrow) {
    margin-left: auto;
    color: var(--text-3);
    flex: none;
    transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .contact__row:hover :global(.contact__arrow) {
    color: var(--secondary-bright);
    transform: translateX(2px);
  }

  /* --------------------------------------------------- availability */
  .contact__availability {
    margin-top: var(--sp-md);
    padding: var(--sp-md);
    border-radius: var(--r-md);
    background: rgba(16, 185, 129, 0.07);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .contact__availability-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--tertiary-bright);
  }

  .contact__availability-body {
    margin-top: 0.375rem;
    padding-left: 1rem;
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--text-2);
  }
</style>
