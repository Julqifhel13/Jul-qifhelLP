---
import Icon from './Icon.astro';
import { certifications } from '../data/site.js';

const counts = certifications.filters.map((f) => ({
  ...f,
  count:
    f.id === 'all'
      ? certifications.items.length
      : certifications.items.filter((c) => c.cat === f.id).length,
}));
---

<section class="section" id="certifications">
  <div class="container">
    <header class="section-head">
      <div data-reveal>
        <p class="eyebrow">{certifications.eyebrow}</p>
        <h2 class="t-h2 section-head__title">{certifications.heading}</h2>
      </div>
      <p class="t-body section-head__note" data-reveal data-reveal-delay="80">
        {certifications.note}
      </p>
    </header>

    <div class="cert__filters no-scrollbar" role="tablist" aria-label="Certification categories" data-reveal>
      {
        counts.map((f, i) => (
          <button
            type="button"
            role="tab"
            class="cert__filter"
            data-filter={f.id}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {f.label}
            <span class="cert__count">{f.count}</span>
          </button>
        ))
      }
    </div>

    <ul class="cert__grid" data-cert-grid>
      {
        certifications.items.map((item, i) => (
          <li
            class="cert__card card card--hover"
            data-cat={item.cat}
            data-reveal
            data-reveal-delay={String(Math.min(i, 8) * 45)}
          >
            <div class="cert__top">
              <span class="cert__issuer">{item.issuer}</span>
              <Icon name="badge" size={15} class="cert__verified" />
            </div>

            <h3 class="cert__title">{item.title}</h3>

            <hr class="rule" />

            <div class="cert__foot">
              <span class="tag">Issued {item.year}</span>
              <span class="cert__status">
                <span class="dot" />
                Verified
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="cert__empty" data-cert-empty hidden>No certifications in this category yet.</p>
  </div>
</section>

<script>
  const grid = document.querySelector<HTMLElement>('[data-cert-grid]');
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const empty = document.querySelector<HTMLElement>('[data-cert-empty]');

  if (grid && filters.length) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-cat]'));

    const apply = (cat: string) => {
      let shown = 0;
      cards.forEach((card) => {
        const match = cat === 'all' || card.dataset.cat === cat;
        card.hidden = !match;
        if (match) shown += 1;
      });
      if (empty) empty.hidden = shown > 0;
    };

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        filters.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
        apply(btn.dataset.filter ?? 'all');
      });
    });
  }
</script>

<style>
  .cert__filters {
    display: flex;
    gap: var(--sp-xs);
    margin-bottom: var(--sp-xl);
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  @media (min-width: 768px) {
    .cert__filters {
      flex-wrap: wrap;
      overflow-x: visible;
    }
  }

  .cert__filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.4375rem 0.75rem;
    border-radius: var(--r-full);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-2);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .cert__filter:hover {
    color: var(--text-1);
    background: rgba(255, 255, 255, 0.04);
  }
  .cert__filter[aria-selected='true'] {
    color: var(--secondary-soft);
    background: rgba(6, 182, 212, 0.1);
    border-color: rgba(6, 182, 212, 0.35);
  }

  .cert__count {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-3);
  }
  .cert__filter[aria-selected='true'] .cert__count {
    color: var(--secondary);
  }

  /* ------------------------------------------------------------ grid */
  .cert__grid {
    display: grid;
    gap: var(--sp-sm);
  }
  @media (min-width: 620px) {
    .cert__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .cert__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-md);
    }
  }

  .cert__card {
    display: flex;
    flex-direction: column;
    padding: var(--sp-md);
  }

  .cert__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-sm);
  }

  .cert__issuer {
    display: inline-flex;
    align-items: center;
    padding: 0.1875rem 0.5rem;
    border-radius: var(--r-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-soft);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  .cert__card :global(.cert__verified) {
    color: var(--text-3);
    flex: none;
    transition: color var(--dur) var(--ease);
  }
  .cert__card:hover :global(.cert__verified) {
    color: var(--secondary-bright);
  }

  .cert__title {
    flex: 1;
    margin-block: var(--sp-sm) var(--sp-md);
    font-size: 0.875rem;
    line-height: 1.45;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-1);
    text-wrap: pretty;
  }

  .cert__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-sm);
    margin-top: var(--sp-sm);
  }

  .cert__status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tertiary-bright);
  }

  .cert__empty {
    margin-top: var(--sp-xl);
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-3);
  }
</style>
