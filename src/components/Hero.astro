---
import Icon from './Icon.astro';
import { hero, profile, stats } from '../data/site.js';
---

<section class="hero section section--flush" id="top">
  <div class="glow glow--primary hero__glow-a"></div>
  <div class="glow glow--secondary hero__glow-b"></div>

  <div class="container hero__grid">
    <!-- ------------------------------------------------------------ copy -->
    <div class="hero__copy">
      <p class="eyebrow" data-reveal>{hero.eyebrow}</p>

      <h1 class="t-hero hero__title" data-reveal data-reveal-delay="60">
        {hero.headlineLead}{' '}
        <span class="accent-text">{hero.headlineAccent}</span>{' '}
        {hero.headlineTail}
      </h1>

      <p class="t-lead hero__intro" data-reveal data-reveal-delay="120">{hero.intro}</p>

      <ul class="hero__chips" data-reveal data-reveal-delay="180">
        {
          hero.chips.map((chip) => (
            <li class="pill pill--muted hero__chip">
              <Icon name={chip.icon} size={13} />
              {chip.label}
            </li>
          ))
        }
      </ul>

      <div class="hero__actions" data-reveal data-reveal-delay="240">
        <a class="btn btn--primary" href={hero.primaryCta.href}>
          {hero.primaryCta.label}
          <Icon name="arrow" size={16} />
        </a>
        <a class="btn btn--ghost" href={hero.secondaryCta.href}>
          {hero.secondaryCta.label}
        </a>
      </div>

      <p class="hero__direct t-code" data-reveal data-reveal-delay="280">
        <span class="dot"></span>
        {hero.directLine}
      </p>
    </div>

    <!-- ------------------------------------------------------ profile card -->
    <aside class="hero__card card card--glass" data-reveal data-reveal-delay="140">
      <div class="hero__card-head">
        <div class="hero__avatar" aria-hidden="true">{profile.initials}</div>
        <div class="hero__id">
          <p class="hero__name">{profile.name}</p>
          <p class="hero__role">{hero.card.role}</p>
        </div>
        <span class="hero__verified" title="Verified profile">
          <Icon name="badge" size={18} />
        </span>
      </div>

      <p class="hero__subrole tag">{hero.card.subRole}</p>

      <hr class="rule" />

      <div class="hero__engine">
        <p class="hero__engine-label">
          <span class="dot dot--pulse"></span>
          {hero.card.status}
        </p>

        <div class="hero__equaliser" aria-hidden="true">
          {Array.from({ length: 22 }).map((_, i) => <span style={`--i:${i}`} />)}
        </div>

        <dl class="hero__metrics">
          {
            hero.card.metrics.map((m) => (
              <div class="hero__metric">
                <dt>{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <p class="hero__footnote">{hero.card.footnote}</p>
    </aside>
  </div>

  <!-- ---------------------------------------------------------- stat strip -->
  <div class="container">
    <div class="stats" data-reveal>
      {
        stats.map((stat) => (
          <div class="stats__cell">
            <p class="stats__value">{stat.value}</p>
            <p class="stats__label">{stat.label}</p>
            <p class="stats__note">{stat.note}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
    padding-top: clamp(2rem, 3.5vw, 3.25rem);
  }

  .hero__glow-a {
    width: 520px;
    height: 520px;
    top: -180px;
    left: -140px;
  }
  .hero__glow-b {
    width: 460px;
    height: 460px;
    top: 40px;
    right: -160px;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--sp-2xl);
    align-items: start;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      /* 7 / 5 split per the design system */
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--sp-3xl);
    }
  }

  /* -------------------------------------------------------------- copy */
  .hero__title {
    margin-top: var(--sp-md);
    max-width: 17ch;
    text-wrap: balance;
  }
  @media (min-width: 640px) {
    .hero__title {
      max-width: 20ch;
    }
  }

  .hero__intro {
    margin-top: var(--sp-lg);
    /* ~68 characters — keeps the measure readable when the grid is single-column */
    max-width: 48ch;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-xs);
    margin-top: var(--sp-lg);
  }
  .hero__chip :global(svg) {
    color: var(--secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-sm);
    margin-top: var(--sp-xl);
  }
  @media (max-width: 420px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  .hero__direct {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--sp-lg);
    color: var(--text-3);
    text-transform: none;
  }

  /* ------------------------------------------------------ profile card */
  .hero__card {
    padding: var(--sp-lg);
    border-radius: var(--r-xl);
    box-shadow: 0 20px 40px -15px rgba(6, 182, 212, 0.15);
  }
  @media (min-width: 1024px) {
    .hero__card {
      margin-top: var(--sp-2xl);
    }
  }

  .hero__card-head {
    display: flex;
    align-items: center;
    gap: var(--sp-sm);
  }

  .hero__avatar {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-md);
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.9) 0%, rgba(6, 182, 212, 0.9) 100%);
    color: #fff;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    flex: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .hero__id {
    min-width: 0;
  }
  .hero__name {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--text-1);
  }
  .hero__role {
    margin-top: 0.125rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--text-3);
  }

  .hero__verified {
    margin-left: auto;
    align-self: flex-start;
    color: var(--secondary-bright);
    flex: none;
  }

  .hero__subrole {
    display: block;
    margin-block: var(--sp-md);
    color: var(--text-3);
  }

  /* ------------------------------------------------------ engine block */
  .hero__engine {
    margin-top: var(--sp-md);
    padding: var(--sp-md);
    border-radius: var(--r-md);
    background: rgba(10, 14, 24, 0.55);
    border: 1px solid var(--border-soft);
  }

  .hero__engine-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tertiary-bright);
  }

  .hero__equaliser {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 44px;
    margin-top: var(--sp-md);
  }
  .hero__equaliser span {
    flex: 1;
    border-radius: 1px;
    background: linear-gradient(180deg, var(--secondary) 0%, rgba(79, 70, 229, 0.55) 100%);
    height: 24%;
    opacity: 0.65;
    animation: eq 2.6s var(--ease) infinite;
    animation-delay: calc(var(--i) * 90ms);
  }
  @keyframes eq {
    0%, 100% { height: 22%; opacity: 0.45; }
    35% { height: 92%; opacity: 1; }
    65% { height: 46%; opacity: 0.7; }
  }

  .hero__metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-sm);
    margin: var(--sp-md) 0 0;
  }
  .hero__metric dt {
    font-size: 0.6875rem;
    color: var(--text-3);
    letter-spacing: 0.01em;
  }
  .hero__metric dd {
    margin: 0.125rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--secondary-bright);
  }

  .hero__footnote {
    margin-top: var(--sp-md);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-3);
  }

  /* -------------------------------------------------------- stat strip */
  .stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-sm);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 960px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--sp-md);
    }
  }

  .stats__cell {
    padding: var(--sp-lg);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-lg);
    background: var(--surface-1);
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .stats__cell:hover {
    border-color: var(--border-accent);
    background: var(--surface-2);
  }

  .stats__value {
    font-size: clamp(1.375rem, 1rem + 1.6vw, 1.875rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(120deg, var(--secondary-bright) 0%, var(--primary-soft) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stats__label {
    margin-top: var(--sp-xs);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--text-1);
  }

  .stats__note {
    margin-top: 0.375rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-3);
  }
</style>
