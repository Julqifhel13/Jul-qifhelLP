---
import Icon from './Icon.astro';
import { hero, profile, stats } from '../data/site.js';

// Resolve the optional headshot against the configured base path
const photo = profile.photo
  ? `${import.meta.env.BASE_URL}/${profile.photo}`.replace(/\/{2,}/g, '/')
  : '';
---

<section class="hero section section--flush" id="top">
  <div class="glow glow--primary hero__glow-a"></div>
  <div class="glow glow--secondary hero__glow-b"></div>

  <div class="container hero__grid">
    <!-- ------------------------------------------------------------ copy -->
    <div class="hero__copy">
      <div class="hero__status" data-reveal>
        <span class="hero__available">
          <span class="dot dot--pulse"></span>
          {hero.availability}
        </span>
      </div>

      <h1 class="t-hero hero__title" data-reveal data-reveal-delay="60">
        {hero.headlineLead}{' '}
        <span class="hero__accent">{hero.headlineAccent}</span>{hero.headlineAccentSuffix}{' '}
        {hero.headlineTail}
      </h1>

      <p class="t-lead hero__intro" data-reveal data-reveal-delay="120">{hero.intro}</p>

      <ul class="hero__chips" data-reveal data-reveal-delay="180">
        {
          hero.chips.map((chip) => (
            <li class={`hero__chip${chip.tone ? ` hero__chip--${chip.tone}` : ''}`}>
              <Icon name={chip.icon} size={13} />
              {chip.label}
            </li>
          ))
        }
      </ul>

      <div class="hero__actions" data-reveal data-reveal-delay="240">
        <a class="btn btn--primary hero__cta" href={hero.primaryCta.href}>
          <Icon name={hero.primaryCta.icon} size={16} />
          {hero.primaryCta.label}
        </a>
      </div>

      <p class="hero__direct t-code" data-reveal data-reveal-delay="280">
        <Icon name="phone" size={13} />
        {hero.directLine}
      </p>
    </div>

    <!-- ------------------------------------------------------ profile card -->
    <aside class="hero__card card card--glass" data-reveal data-reveal-delay="140">
      <div class="hero__chrome" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>

      <div class="hero__card-head">
        {
          photo ? (
            <img class="hero__photo" src={photo} alt={profile.name} width="156" height="156" />
          ) : (
            <div class="hero__photo hero__photo--fallback" aria-hidden="true">
              {profile.initials}
            </div>
          )
        }

        <div class="hero__id">
          <p class="hero__name">{profile.name}</p>
          <p class="hero__role">{hero.card.role}</p>
          <p class="hero__cred">{hero.card.credential}</p>
        </div>
      </div>

      <div class="hero__engine">
        <p class="hero__engine-label">{hero.card.status}</p>

        <ol class="pipe">
          {
            hero.card.pipeline.map((stage, i) => (
              <>
                {i > 0 && <li class="pipe__link" aria-hidden="true" />}
                <li class={`pipe__node pipe__node--${stage.tone}`}>
                  <span class="pipe__title">{stage.title}</span>
                  <span class="pipe__meta">{stage.meta}</span>
                </li>
              </>
            ))
          }
        </ol>
      </div>

      <div class="hero__card-foot">
        <p class="hero__verified">
          <Icon name="shield" size={15} />
          {hero.card.verified}
        </p>
        <button
          class="hero__copy-email"
          type="button"
          data-copy-email={profile.email}
          data-copied-label={hero.card.copiedLabel}
        >
          {hero.card.copyLabel}
        </button>
      </div>
    </aside>
  </div>

  <!-- ---------------------------------------------------------- stat strip -->
  <div class="container">
    <div class="stats" data-reveal>
      {
        stats.map((stat) => (
          <div class="stats__cell">
            <p class="stats__value">{stat.value}</p>
            <p class="stats__label">{stat.label}</p>
            <p class="stats__note">{stat.note}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-email]');

  if (copyBtn) {
    const email = copyBtn.dataset.copyEmail ?? '';
    const idle = copyBtn.textContent?.trim() ?? 'Copy Email';
    const done = copyBtn.dataset.copiedLabel ?? 'Copied';
    let timer: number | undefined;

    const flash = () => {
      copyBtn.textContent = done;
      copyBtn.classList.add('is-copied');
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        copyBtn.textContent = idle;
        copyBtn.classList.remove('is-copied');
      }, 1800);
    };

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
        flash();
      } catch {
        // Clipboard API needs a secure context — fall back to the mail client
        window.location.href = `mailto:${email}`;
      }
    });
  }
</script>

<style>
  .hero {
    overflow: hidden;
    padding-top: clamp(2rem, 3.5vw, 3.25rem);
  }

  .hero__glow-a {
    width: 520px;
    height: 520px;
    top: -180px;
    left: -140px;
  }
  .hero__glow-b {
    width: 460px;
    height: 460px;
    top: 40px;
    right: -160px;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--sp-2xl);
    align-items: start;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      /* 7 / 5 split per the design system */
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--sp-3xl);
    }
  }

  /* -------------------------------------------------------------- copy */

  /* availability badge + credential label */
  .hero__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-xs) var(--sp-sm);
  }

  .hero__available {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.3125rem 0.75rem;
    border-radius: var(--r-full);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: var(--tertiary-bright);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .hero__title {
    margin-top: var(--sp-lg);
    max-width: 17ch;
    text-wrap: balance;
  }
  @media (min-width: 640px) {
    .hero__title {
      max-width: 20ch;
    }
  }

  /* focal keywords in a solid cyan fill */
  .hero__accent {
    color: var(--secondary-bright);
  }

  .hero__intro {
    margin-top: var(--sp-lg);
    /* ~68 characters — keeps the measure readable when the grid is single-column */
    max-width: 48ch;
  }

  /* capability chips — rounded rectangles, not pills */
  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-xs);
    margin-top: var(--sp-xl);
  }

  .hero__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.4375rem 0.6875rem;
    border-radius: var(--r);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    color: var(--text-1);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }
  .hero__chip :global(svg) {
    color: var(--secondary-bright);
    flex: none;
  }
  .hero__chip--tertiary :global(svg) {
    color: var(--tertiary-bright);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-sm);
    margin-top: var(--sp-xl);
  }

  /* wide, single primary CTA in a solid violet rather than the site gradient */
  .hero__cta {
    width: 100%;
    max-width: 264px;
    height: 48px;
    background: linear-gradient(180deg, #5b51ef 0%, #4f46e5 100%);
  }
  .hero__cta:hover {
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 24px rgba(79, 70, 229, 0.45);
  }

  .hero__direct {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--sp-lg);
    color: var(--text-3);
    text-transform: none;
  }
  .hero__direct :global(svg) {
    color: var(--secondary);
    flex: none;
  }

  /* ------------------------------------------------------ profile card */
  .hero__card {
    padding: var(--sp-lg);
    border-radius: var(--r-xl);
    box-shadow: 0 20px 40px -15px rgba(6, 182, 212, 0.15);
  }
  @media (min-width: 1024px) {
    .hero__card {
      margin-top: var(--sp-2xl);
    }
  }

  /* ----------------------------------------------------- window chrome */
  .hero__chrome {
    display: flex;
    gap: 6px;
    margin-bottom: var(--sp-lg);
  }
  .hero__chrome span {
    width: 10px;
    height: 10px;
    border-radius: var(--r-full);
  }
  .hero__chrome span:nth-child(1) { background: #ff7b72; }
  .hero__chrome span:nth-child(2) { background: var(--secondary-bright); }
  .hero__chrome span:nth-child(3) { background: var(--tertiary-bright); }

  /* --------------------------------------------------------- identity */
  .hero__card-head {
    display: flex;
    align-items: center;
    gap: var(--sp-md);
  }

  .hero__photo {
    width: 78px;
    height: 78px;
    border-radius: var(--r-md);
    object-fit: cover;
    flex: none;
    border: 1px solid var(--border);
  }
  .hero__photo--fallback {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.9) 0%, rgba(6, 182, 212, 0.9) 100%);
    color: #fff;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    border-color: transparent;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .hero__id {
    min-width: 0;
  }
  .hero__name {
    font-size: clamp(1.25rem, 1.05rem + 0.85vw, 1.5rem);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-1);
  }
  .hero__role {
    margin-top: 0.3125rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    font-weight: 500;
    color: var(--secondary-bright);
  }
  .hero__cred {
    margin-top: 0.3125rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--text-3);
  }

  /* ------------------------------------------------------ engine panel */
  .hero__engine {
    margin-top: var(--sp-lg);
    padding: var(--sp-md);
    border-radius: var(--r-md);
    background: rgba(7, 10, 17, 0.6);
    border: 1px solid var(--border-soft);
  }

  .hero__engine-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  /* --------------------------------------------------- pipeline diagram */
  .pipe {
    display: flex;
    align-items: stretch;
    margin-top: var(--sp-lg);
  }

  .pipe__node {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1875rem;
    padding: 0.5rem 0.4375rem;
    border-radius: var(--r);
    border: 1px solid var(--border);
    background: var(--surface-2);
    text-align: center;
  }

  .pipe__title {
    font-size: 0.625rem;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--text-1);
  }

  .pipe__meta {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: var(--text-3);
  }

  /* stage 1 — capture */
  .pipe__node--idle .pipe__meta {
    color: var(--secondary-bright);
  }

  /* stage 2 — the active engine, lifted and lit */
  .pipe__node--active {
    background: #4438c9;
    border-color: var(--primary-bright);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
    padding-block: 0.6875rem;
    margin-block: -0.1875rem;
  }
  .pipe__node--active .pipe__meta {
    color: rgba(255, 255, 255, 0.75);
  }

  /* stage 3 — conversion */
  .pipe__node--success {
    border-color: rgba(16, 185, 129, 0.35);
    background: rgba(16, 185, 129, 0.07);
  }
  .pipe__node--success .pipe__title {
    color: var(--tertiary-bright);
  }

  /* connector: a cyan trace capped with a node dot at each end */
  .pipe__link {
    flex: 0 0 22px;
    align-self: center;
    position: relative;
    height: 1px;
    background: var(--secondary);
  }
  .pipe__link::before,
  .pipe__link::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: var(--r-full);
    background: var(--secondary-bright);
    transform: translateY(-50%);
  }
  .pipe__link::before { left: -1px; }
  .pipe__link::after { right: -1px; }

  /* Small laptops (1024–1279px): the 7/5 split leaves the card ~373px wide,
     so tighten the card's own padding and type to keep every stage label on
     one line. The hero's left column is deliberately left untouched. */
  @media (min-width: 1024px) and (max-width: 1279.98px) {
    .hero__card {
      padding: var(--sp-md);
    }
    .hero__engine {
      padding: 0.75rem;
    }
    .pipe__node {
      padding-inline: 0.375rem;
    }
    .pipe__title {
      font-size: 0.5625rem;
    }
    .pipe__meta {
      font-size: 0.5rem;
    }
    .pipe__link {
      flex-basis: 16px;
    }
  }

  /* Narrow cards: rotate the flow into a vertical rail */
  @media (max-width: 540px) {
    .pipe {
      flex-direction: column;
    }
    .pipe__node--active {
      margin-block: 0;
    }
    .pipe__link {
      flex-basis: 20px;
      width: 1px;
      height: auto;
    }
    .pipe__link::before,
    .pipe__link::after {
      top: auto;
      left: 50%;
      transform: translateX(-50%);
    }
    .pipe__link::before { top: -1px; }
    .pipe__link::after { bottom: -1px; }
  }

  /* -------------------------------------------------------- card footer */
  .hero__card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-sm);
    margin-top: var(--sp-lg);
  }

  .hero__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    min-width: 0;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--text-2);
  }
  .hero__verified :global(svg) {
    color: var(--secondary-bright);
    flex: none;
  }

  .hero__copy-email {
    flex: none;
    padding: 0.4375rem 0.6875rem;
    border-radius: var(--r);
    border: 1px solid var(--border);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--secondary-bright);
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .hero__copy-email:hover {
    border-color: var(--border-accent);
    background: rgba(6, 182, 212, 0.1);
  }
  .hero__copy-email.is-copied {
    color: var(--tertiary-bright);
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.1);
  }

  /* -------------------------------------------------------- stat strip */
  .stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-sm);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 960px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--sp-md);
    }
  }

  .stats__cell {
    padding: var(--sp-lg);
    border: 1px solid var(--border-soft);
    border-radius: var(--r-lg);
    background: var(--surface-1);
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .stats__cell:hover {
    border-color: var(--border-accent);
    background: var(--surface-2);
  }

  .stats__value {
    font-size: clamp(1.375rem, 1rem + 1.6vw, 1.875rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(120deg, var(--secondary-bright) 0%, var(--primary-soft) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stats__label {
    margin-top: var(--sp-xs);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--text-1);
  }

  .stats__note {
    margin-top: 0.375rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--text-3);
  }
</style>
