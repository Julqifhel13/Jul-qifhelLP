---
import Icon from './Icon.astro';
import { experience } from '../data/site.js';
---

<section class="section" id="experience">
  <div class="container">
    <header class="section-head">
      <div data-reveal>
        <p class="eyebrow">{experience.eyebrow}</p>
        <h2 class="t-h2 section-head__title">{experience.heading}</h2>
      </div>
      <p class="t-body section-head__note" data-reveal data-reveal-delay="80">
        {experience.note}
      </p>
    </header>

    <ol class="xp">
      {
        experience.roles.map((role, i) => (
          <li class="xp__item" data-reveal data-reveal-delay={String(i * 80)}>
            <span class={`xp__node${role.current ? ' xp__node--live' : ''}`} aria-hidden="true" />

            <article class={`xp__card card${role.current ? ' xp__card--current' : ''}`}>
              <div class="xp__top">
                <div class="xp__badges">
                  <span class={`pill pill--${role.badge.tone}`}>
                    {role.current && <span class="dot dot--pulse" />}
                    {role.badge.label}
                  </span>
                  <span class="pill pill--muted">{role.period}</span>
                </div>

                <ul class="xp__stack">
                  {role.stack.map((tech) => (
                    <li class="tag">{tech}</li>
                  ))}
                </ul>
              </div>

              <h3 class="t-h3 xp__company">{role.company}</h3>
              <p class="xp__subtitle">{role.subtitle}</p>

              <ul class="xp__bullets">
                {role.bullets.map((bullet) => (
                  <li class="xp__bullet">
                    <span class="xp__bullet-icon" aria-hidden="true">
                      <Icon name="check" size={12} stroke={2.4} />
                    </span>
                    <div>
                      <h4 class="xp__bullet-title">{bullet.title}</h4>
                      <p class="xp__bullet-body">{bullet.body}</p>
                    </div>
                  </li>
                ))}
              </ul>

              <footer class="xp__footer">
                <p class="xp__footer-text">{role.footer}</p>
                <span class="xp__footer-tag tag">{role.footerTag}</span>
              </footer>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .xp {
    position: relative;
    display: grid;
    gap: var(--sp-lg);
    margin: 0;
  }

  .xp__item {
    position: relative;
  }

  /* Connection rail — left-anchored on mobile, gutter rail on desktop */
  .xp__node {
    display: none;
  }
  @media (min-width: 1024px) {
    .xp {
      padding-left: 2.25rem;
    }
    .xp::before {
      content: '';
      position: absolute;
      left: 5px;
      top: 12px;
      bottom: 12px;
      width: 2px;
      background: rgba(255, 255, 255, 0.1);
    }
    .xp__node {
      display: block;
      position: absolute;
      left: -2.25rem;
      top: 26px;
      width: 12px;
      height: 12px;
      border-radius: var(--r-full);
      background: var(--surface-3);
      border: 2px solid var(--canvas);
      box-shadow: 0 0 0 1px var(--border-strong);
    }
    .xp__node--live {
      background: var(--secondary);
      box-shadow: 0 0 0 1px var(--border-accent), 0 0 16px rgba(6, 182, 212, 0.6);
    }
  }

  /* ---------------------------------------------------------------- card */
  .xp__card {
    padding: var(--sp-lg);
    border-left: 2px solid var(--border-soft);
    transition: border-color var(--dur) var(--ease);
  }
  @media (min-width: 768px) {
    .xp__card {
      padding: var(--sp-xl);
    }
  }
  .xp__card:hover {
    border-color: var(--border);
    border-left-color: rgba(6, 182, 212, 0.4);
  }
  .xp__card--current {
    border-left-color: var(--tertiary);
  }

  .xp__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-sm) var(--sp-md);
  }

  .xp__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-xs);
  }

  .xp__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-sm);
  }
  .xp__stack li {
    position: relative;
  }
  .xp__stack li + li::before {
    content: '·';
    position: absolute;
    left: calc(var(--sp-sm) / -2 - 2px);
    color: var(--outline, #464555);
  }

  .xp__company {
    margin-top: var(--sp-lg);
  }

  .xp__subtitle {
    margin-top: var(--sp-2xs);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-2);
    max-width: 74ch;
  }

  /* ------------------------------------------------------------- bullets */
  .xp__bullets {
    display: grid;
    gap: var(--sp-lg);
    margin-top: var(--sp-xl);
  }
  @media (min-width: 900px) {
    .xp__bullets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-lg) var(--sp-xl);
    }
  }

  .xp__bullet {
    display: flex;
    gap: var(--sp-sm);
  }

  .xp__bullet-icon {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: var(--r-sm);
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.25);
    color: var(--secondary-bright);
    flex: none;
  }

  .xp__bullet-title {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--text-1);
  }

  .xp__bullet-body {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.62;
    color: var(--text-2);
  }

  /* -------------------------------------------------------------- footer */
  .xp__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-sm) var(--sp-md);
    margin-top: var(--sp-xl);
    padding: var(--sp-md);
    border-radius: var(--r-md);
    background: rgba(10, 14, 24, 0.6);
    border: 1px solid var(--border-soft);
  }

  .xp__footer-text {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-2);
    max-width: 68ch;
  }

  .xp__footer-tag {
    color: var(--secondary);
    flex: none;
  }
</style>
