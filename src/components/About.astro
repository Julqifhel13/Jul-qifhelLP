---
import Icon from './Icon.astro';
import { about } from '../data/site.js';
---

<section class="section" id="about">
  <div class="container">
    <div class="about__top">
      <div data-reveal>
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 class="t-h2 about__title">
          {about.heading.map((line) => <span class="about__line">{line}</span>)}
        </h2>
        <p class="t-lead about__body">{about.body}</p>
      </div>

      <figure class="about__objective card" data-reveal data-reveal-delay="100">
        <figcaption class="about__objective-label">
          <Icon name="target" size={14} />
          {about.objective.label}
        </figcaption>
        <blockquote class="about__quote">{about.objective.quote}</blockquote>
        <hr class="rule" />
        <ul class="about__meta">
          {about.objective.meta.map((m) => <li class="tag">{m}</li>)}
        </ul>
      </figure>
    </div>

    <ul class="about__pillars">
      {
        about.pillars.map((pillar, i) => (
          <li
            class="about__pillar card card--hover"
            data-reveal
            data-reveal-delay={String(i * 70)}
          >
            <span class={`icon-tile icon-tile--${pillar.accent}`}>
              <Icon name={pillar.icon} size={18} />
            </span>
            <h3 class="about__pillar-title">{pillar.title}</h3>
            <p class="about__pillar-body">{pillar.body}</p>
            <hr class="rule" />
            <ul class="about__pillar-tags">
              {pillar.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__top {
    display: grid;
    gap: var(--sp-xl);
    align-items: start;
  }
  @media (min-width: 960px) {
    .about__top {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--sp-3xl);
    }
  }

  .about__title {
    margin-top: var(--sp-md);
    text-wrap: balance;
  }
  .about__line {
    display: block;
  }

  .about__body {
    margin-top: var(--sp-lg);
    max-width: 46ch;
  }

  /* ------------------------------------------------------ objective card */
  .about__objective {
    padding: var(--sp-lg);
    margin: 0;
    border-radius: var(--r-lg);
    background: var(--surface-1);
  }
  @media (min-width: 960px) {
    .about__objective {
      margin-top: var(--sp-xl);
    }
  }

  .about__objective-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .about__quote {
    margin: var(--sp-md) 0 var(--sp-lg);
    font-size: 0.9375rem;
    line-height: 1.66;
    color: var(--text-2);
    border-left: 2px solid rgba(79, 70, 229, 0.5);
    padding-left: var(--sp-md);
  }

  .about__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-md);
    margin-top: var(--sp-md);
  }
  .about__meta li {
    position: relative;
  }
  .about__meta li + li::before {
    content: '';
    position: absolute;
    left: calc(var(--sp-md) / -2);
    top: 50%;
    width: 3px;
    height: 3px;
    border-radius: var(--r-full);
    background: var(--outline, var(--text-3));
    transform: translateY(-50%);
  }

  /* ----------------------------------------------------------- pillars */
  .about__pillars {
    display: grid;
    gap: var(--sp-md);
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 640px) {
    .about__pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .about__pillars {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .about__pillar {
    display: flex;
    flex-direction: column;
    padding: var(--sp-lg);
  }

  .about__pillar-title {
    margin-top: var(--sp-md);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--text-1);
  }

  .about__pillar-body {
    margin-top: var(--sp-xs);
    margin-bottom: var(--sp-lg);
    flex: 1;
    font-size: 0.8125rem;
    line-height: 1.62;
    color: var(--text-2);
  }

  .about__pillar-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-sm);
    margin-top: var(--sp-md);
  }
</style>
