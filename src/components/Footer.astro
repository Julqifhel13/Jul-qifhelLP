---
import Icon from './Icon.astro';
import { footer, profile } from '../data/site.js';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="#top" class="footer__mark" aria-label={`${profile.name} — back to top`}>
          <span class="footer__initials">{profile.initials}</span>
          <span class="footer__name">{profile.name}</span>
        </a>
        <p class="footer__blurb">{footer.blurb}</p>

        <ul class="footer__socials">
          {
            profile.socials.map((social) => (
              <li>
                <a
                  class="btn btn--icon"
                  href={social.href}
                  aria-label={social.label}
                  rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                >
                  <Icon name={social.icon} size={17} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        footer.columns.map((col) => (
          <nav class="footer__col" aria-label={col.title}>
            <h2 class="footer__col-title">{col.title}</h2>
            <ul class="footer__links">
              {col.links.map((link) => (
                <li>
                  {link.href ? (
                    <a class="footer__link" href={link.href}>
                      {link.label}
                    </a>
                  ) : (
                    <span class="footer__link footer__link--static">{link.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <hr class="rule footer__rule" />

    <div class="footer__bottom">
      <p class="footer__legal">© {year} {profile.name}. {footer.legal}</p>
      <div class="footer__bottom-right">
        <span class="tag">{footer.builtWith}</span>
        <a class="footer__top" href="#top">
          Back to top
          <Icon name="arrowUp" size={14} />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(2.5rem, 6vw, 4rem) var(--sp-xl);
    border-top: 1px solid var(--border-soft);
    background: var(--surface-inset);
  }

  .footer__grid {
    display: grid;
    gap: var(--sp-xl);
  }
  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: minmax(0, 1.6fr) repeat(2, minmax(0, 1fr));
      gap: var(--sp-2xl);
    }
  }

  /* ----------------------------------------------------------- brand */
  .footer__mark {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-sm);
  }

  .footer__initials {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: var(--r);
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 800;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .footer__name {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--text-1);
  }

  .footer__blurb {
    margin-top: var(--sp-md);
    max-width: 46ch;
    font-size: 0.8125rem;
    line-height: 1.66;
    color: var(--text-3);
  }

  .footer__socials {
    display: flex;
    gap: var(--sp-xs);
    margin-top: var(--sp-lg);
  }

  /* --------------------------------------------------------- columns */
  .footer__col-title {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--secondary);
  }

  .footer__links {
    display: grid;
    gap: 0.625rem;
    margin-top: var(--sp-md);
  }

  .footer__link {
    font-size: 0.8125rem;
    color: var(--text-2);
    transition: color var(--dur) var(--ease);
    overflow-wrap: anywhere;
  }
  a.footer__link:hover {
    color: var(--secondary-bright);
  }
  .footer__link--static {
    color: var(--text-3);
  }

  /* ---------------------------------------------------------- bottom */
  .footer__rule {
    margin-block: clamp(2rem, 5vw, 3rem) var(--sp-lg);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-sm) var(--sp-md);
  }

  .footer__legal {
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .footer__bottom-right {
    display: flex;
    align-items: center;
    gap: var(--sp-md);
  }

  .footer__top {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-2);
    transition: color var(--dur) var(--ease);
  }
  .footer__top:hover {
    color: var(--secondary-bright);
  }
</style>
